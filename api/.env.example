# Copy to .env (never commit the real one). Used by `npm run migrate` / `npm run deploy` and the tests.
# Supabase: Connect > Session pooler URI. For a local database add DATABASE_SSL=disable.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lbs
DATABASE_SSL=disable
# First owner login, created only when the staff table is empty.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please
OWNER_NAME=Owner
# The Worker's JWT_SECRET is a Wrangler secret (`wrangler secret put JWT_SECRET`); locally put it in .dev.vars.
