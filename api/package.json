{
  "name": "lbs-cafe-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler types && tsc",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "deploy": "npm run migrate && npm --prefix ../web run build && wrangler deploy",
    "localdb": "tsx scripts/localdb.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "embedded-postgres": "^17.2.0-beta.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.147.0"
  }
}
